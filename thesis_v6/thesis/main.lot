\contentsline {table}{\numberline {4.1}{\ignorespaces Final sample counts and train/test partition sizes for the four Stage~1 scenarios.}}{39}{table.caption.13}%
\contentsline {table}{\numberline {4.2}{\ignorespaces Training hyperparameters, identical across Stage~0 and Stage~1.}}{40}{table.caption.14}%
\contentsline {table}{\numberline {4.3}{\ignorespaces Stage~0 reproduction results, averaged over 30 random seeds.}}{42}{table.caption.16}%
\contentsline {table}{\numberline {4.4}{\ignorespaces Top-2 accuracy for all four Stage~1 comparisons, averaged over 10 random seeds.}}{43}{table.caption.17}%
\contentsline {table}{\numberline {4.5}{\ignorespaces Per-seed spread of top-2 accuracy (10 seeds) at 100, 150, and 200 real target samples.}}{44}{table.caption.19}%
\contentsline {table}{\numberline {4.6}{\ignorespaces Top-2 accuracy at a fixed 100 real target samples, comparing a 40-epoch and an 80-epoch fine-tuning budget.}}{44}{table.caption.20}%
\contentsline {table}{\numberline {4.7}{\ignorespaces Zero-shot (zero real target samples) top-2 accuracy for all four Stage~2 models, across all four comparisons. The non-parametric models' zero-shot fit -- on the source scenario alone -- is procedurally identical under both the rehearsal protocol and the discarded target-only protocol described in \autoref {sec:stage2protocol}; small differences from earlier reported values reflect re-running this fit alongside the corrected sweep rather than any change in what is being measured.}}{45}{table.caption.21}%
\contentsline {table}{\numberline {4.8}{\ignorespaces Top-2 accuracy at two hundred real target samples for all four Stage~2 models, across all four comparisons, under the rehearsal protocol described in \autoref {sec:stage2protocol}. The best-performing model per comparison is bolded.}}{45}{table.caption.22}%
\contentsline {table}{\numberline {4.9}{\ignorespaces Top-2 accuracy for all eight Stage~3 comparisons, averaged over 10 random seeds, using the reference multi-layer perceptron and the identical protocol used throughout Stage~1.}}{48}{table.caption.25}%
\contentsline {table}{\numberline {4.10}{\ignorespaces GPS position-quality metadata for Scenario~1 versus Scenarios~32 and~33, drawn directly from each scenario's raw DeepSense~6G development CSV file.}}{50}{table.caption.28}%
\contentsline {table}{\numberline {4.11}{\ignorespaces Cross-road position standard deviation per five-meter along-road bin, Scenario~32. The cross-road spread nearly triples beginning at the $[45,50)$~m bin, the geometric signature of the road curving away from its dominant heading.}}{51}{table.caption.30}%
\contentsline {table}{\numberline {4.12}{\ignorespaces Full-data (R3--R6) versus straight-segment-only (S3--S6) top-2 accuracy, reported as full~/~straight pairs at each sample count.}}{55}{table.caption.38}%
\contentsline {table}{\numberline {4.13}{\ignorespaces Base station orientation estimates for Scenarios~1, 2, 32, and~33, using the center-beam least-squares procedure described in \autoref {sec:data}. Scenario~33's estimate is identical for the full and straight-only data, indicating all of its center-beam samples happen to lie on the straight segment.}}{56}{table.caption.40}%
\contentsline {table}{\numberline {4.14}{\ignorespaces Top-2 accuracy at zero and two hundred real target samples for all six Stage~5 comparisons, averaged over 10 random seeds, under the rehearsal protocol of \autoref {sec:stage2protocol}. College Avenue targets use the curvature-free straight-segment data from Stage~4.}}{57}{table.caption.41}%
